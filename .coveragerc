[run]
source = .
omit =
    tests/*
    setup.py
    */__pycache__/*
    */site-packages/*
    .venv/*
    venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

precision = 2
show_missing = True

[html]
directory = htmlcov
